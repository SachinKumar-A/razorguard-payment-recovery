# Authentication for POST /ingest. Set one. The service refuses to start with
# neither unless RAZORGUARD_ALLOW_INSECURE=1, which is only ever acceptable
# on a private network.
#
# Preferred: request signing. Survives replay, no long-lived secret on the wire.
RAZORGUARD_HMAC_KEY=change-me-to-32-random-bytes
# Simpler: a shared bearer token. Adequate behind a mesh or VPC.
# RAZORGUARD_TOKEN=change-me

# Where escalations and rollbacks are delivered. Unset disables alerting.
# RAZORGUARD_ALERT_WEBHOOK=https://hooks.example.com/razorguard

# Seconds per control-plane tick. 60 in production.
# RAZORGUARD_TICK_SECONDS=60

# Razorpay, for `python -m razorguard.execute --live`.
#
# Free and instant: sign up at dashboard.razorpay.com, confirm the toggle in the
# top bar reads TEST MODE, then Settings -> API Keys -> Generate Test Key. No
# business verification is needed for test mode.
#
# The secret is shown exactly once, at generation. Paste it here immediately;
# if you lose it you regenerate the pair.
#
# A key not starting rzp_test_ is refused by the executor, so there is no way to
# point this at a live merchant account by accident.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Only for `python -m razorguard.narrate --claude`. Absent, narration falls
# back to the deterministic template.
# ANTHROPIC_API_KEY=
